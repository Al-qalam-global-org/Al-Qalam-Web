generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum ClassType {
  ONE_TO_ONE
  GROUP
}

enum MeetingPlatform {
  ZOOM
  GOOGLE_MEET
}

enum ClassStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum MaterialType {
  PDF
  IMAGE
  DOCUMENT
  LINK
}

enum NoteVisibility {
  STUDENT_VISIBLE
  INTERNAL
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  REVIEWED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(STUDENT)
  status       UserStatus  @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  student             Student?
  teacher             Teacher?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Student {
  id           String     @id @default(cuid())
  userId       String     @unique
  firstName    String
  lastName     String
  profileImage String?
  phone        String?
  dateOfBirth  DateTime?
  country      String?
  timezone     String     @default("UTC")
  grade        String?
  level        String     @default("Beginner")
  parentName   String?
  parentPhone  String?
  parentEmail  String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  courses      StudentCourse[]
  assignments  TeacherStudentAssignment[]
  classMembers ClassStudent[]
  attendance   Attendance[]
  topics       TopicCovered[]
  notes        TeacherNote[]
  progress     StudentProgress[]
  submissions  AssignmentSubmission[]
  results      AssessmentResult[]
  certificates Certificate[]

  @@index([userId])
  @@index([status])
}

model Teacher {
  id              String     @id @default(cuid())
  userId          String     @unique
  firstName       String
  lastName        String
  profileImage    String?
  phone           String?
  country         String?
  timezone        String     @default("UTC")
  qualification   String?
  experienceYears Int        @default(0)
  specialization  String?
  bio             String?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedStudents TeacherStudentAssignment[]
  classes          Class[]
  notes            TeacherNote[]
  assignments      Assignment[]
  assessments      Assessment[]

  @@index([userId])
  @@index([status])
}

model Course {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String
  imageUrl    String?
  category    String     @default("General")
  ageGroup    String     @default("All Ages")
  level       String     @default("Beginner")
  duration    String     @default("3 Months")
  isFeatured  Boolean    @default(false)
  displayOrder Int       @default(0)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  students    StudentCourse[]
  assignments TeacherStudentAssignment[]
  classes     Class[]
  materials   CourseMaterial[]
  courseAssignments Assignment[]
  assessments Assessment[]
  progress    StudentProgress[]
  certificates Certificate[]

  @@index([slug])
  @@index([status])
  @@index([category])
}

model StudentCourse {
  id              String     @id @default(cuid())
  studentId       String
  courseId        String
  startDate       DateTime   @default(now())
  endDate         DateTime?
  status          UserStatus @default(ACTIVE)
  currentProgress Int        @default(0)
  currentLevel    String     @default("Beginner")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model TeacherStudentAssignment {
  id         String     @id @default(cuid())
  teacherId  String
  studentId  String
  courseId   String
  assignedAt DateTime   @default(now())
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId, courseId])
  @@index([teacherId])
  @@index([studentId])
  @@index([courseId])
}

model Class {
  id              String          @id @default(cuid())
  courseId        String
  teacherId       String
  scheduledDate   DateTime
  startTime       String
  endTime         String
  timezone        String          @default("UTC")
  classType       ClassType       @default(ONE_TO_ONE)
  meetingPlatform MeetingPlatform @default(ZOOM)
  meetingUrl      String
  status          ClassStatus     @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  students   ClassStudent[]
  attendance Attendance[]
  topics     TopicCovered[]
  notes      TeacherNote[]

  @@index([teacherId])
  @@index([courseId])
  @@index([scheduledDate])
  @@index([status])
}

model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

model Attendance {
  id        String           @id @default(cuid())
  classId   String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  markedBy  String?
  markedAt  DateTime         @default(now())
  note      String?

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

model TopicCovered {
  id          String   @id @default(cuid())
  classId     String
  studentId   String
  title       String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([studentId])
}

model TeacherNote {
  id         String         @id @default(cuid())
  studentId  String
  teacherId  String
  classId    String?
  note       String
  visibility NoteVisibility @default(STUDENT_VISIBLE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
}

model StudentProgress {
  id                 String   @id @default(cuid())
  studentId          String
  courseId           String
  progressPercentage Int      @default(0)
  currentLevel       String   @default("Beginner")
  completedTopics    Int      @default(0)
  totalTopics        Int      @default(20)
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model CourseMaterial {
  id                 String       @id @default(cuid())
  courseId           String
  title              String
  description        String?
  type               MaterialType @default(PDF)
  fileUrl            String
  cloudinaryPublicId String?
  externalUrl        String?
  uploadedBy         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Assignment {
  id                 String     @id @default(cuid())
  courseId           String
  teacherId          String
  title              String
  description        String
  dueDate            DateTime?
  attachmentUrl      String?
  cloudinaryPublicId String?
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([teacherId])
}

model AssignmentSubmission {
  id                 String           @id @default(cuid())
  assignmentId       String
  studentId          String
  submissionText     String?
  attachmentUrl      String?
  cloudinaryPublicId String?
  status             SubmissionStatus @default(SUBMITTED)
  teacherFeedback    String?
  submittedAt        DateTime         @default(now())
  reviewedAt         DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model Assessment {
  id             String     @id @default(cuid())
  courseId       String
  teacherId      String
  title          String
  description    String?
  assessmentDate DateTime?
  totalMarks     Int        @default(100)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  results AssessmentResult[]

  @@index([courseId])
  @@index([teacherId])
}

model AssessmentResult {
  id            String    @id @default(cuid())
  assessmentId  String
  studentId     String
  obtainedMarks Int
  remarks       String?
  gradedBy      String?
  gradedAt      DateTime  @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

model Certificate {
  id                String   @id @default(cuid())
  studentId         String
  courseId          String
  certificateNumber String   @unique
  completionDate    DateTime @default(now())
  issuedBy          String   @default("Al-Qalam Global Academy")
  certificateUrl    String?
  createdAt         DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([certificateNumber])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
}

model CmsSection {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "home_hero", "home_stats", "learning_paths", "site_contact", "about_content"
  page        String   @default("HOME") // e.g. "HOME", "ABOUT", "CONTACT", "PROGRAMS"
  sectionName String   // Human readable label e.g. "Hero & Main Banner"
  content     Json     // Structured JSON payload
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([key])
  @@index([page])
}

model Testimonial {
  id             String   @id @default(cuid())
  authorName     String
  roleOrLocation String?  // e.g. "Parent, UAE" or "Adult Learner, UK"
  quote          String
  avatarUrl      String?
  rating         Int      @default(5)
  isPublished    Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished])
  @@index([displayOrder])
}
